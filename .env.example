APP_NAME=PayGate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://paygate.local

# Host names: portals (admin/partner/branch), partner API, public payer pages
APP_DOMAIN=paygate.local
API_DOMAIN=api.paygate.local
PAY_DOMAIN=pay.paygate.local
HORIZON_DOMAIN=paygate.local
# Single-domain setup (e.g. a demo): set API_DOMAIN and PAY_DOMAIN to APP_DOMAIN and
# give the API and payer pages a path prefix instead (API_PATH=api, PAY_PATH=pay).
API_PATH=
PAY_PATH=

# Business day boundary for daily limits/reports (timestamps are stored in UTC)
BUSINESS_TIMEZONE=Asia/Kolkata

# Require 2FA for Admin and Branch users (keep true outside your own machine)
# Blind-index key for bank/UPI numbers (Deployment.md §2). Never change once set.
PAYGATE_HASH_KEY=
# Refuse Partner API calls from IPs not on the partner's list (keep true outside your machine)
PAYGATE_API_ENFORCE_IP=true
# Allow webhooks to private addresses / http (only on your own machine)
PAYGATE_WEBHOOKS_ALLOW_PRIVATE=false
PAYGATE_ENFORCE_2FA=true
# Admin › QA Checklist (default: on for local/staging, always off on production)
# PAYGATE_QA_CHECKLIST=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=paygate
DB_USERNAME=paygate
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@paygate.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
